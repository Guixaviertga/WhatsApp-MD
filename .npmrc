# Evita que o npm tente instalar automaticamente peer dependencies opcionais
# do Baileys (como "sharp", usada só para gerar miniaturas de preview).
# O sharp não tem binários pré-compilados para Android/Termux (arm64) e sua
# compilação a partir do código-fonte falha nesse ambiente; como o próprio
# Baileys já trata a ausência dele como opcional (cai para "jimp" ou nenhuma
# miniatura), não precisamos dele instalado.
legacy-peer-deps=true
