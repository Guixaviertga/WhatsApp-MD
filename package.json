{
  "name": "whatsapp-md",
  "version": "1.0.0",
  "description": "Bot de WhatsApp em Node.js com suporte a múltiplas sessões, respostas automáticas multilíngues, visualização de status, confirmação de leitura, rejeição automática de chamadas e criação de figurinhas.",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "baileys",
    "multi-session",
    "termux",
    "pterodactyl"
  ],
  "license": "MIT",
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.9",
    "dotenv": "^16.4.5",
    "pino": "^9.4.0",
    "qrcode-terminal": "^0.12.0",
    "wa-sticker-formatter": "^4.4.4"
  }
}
