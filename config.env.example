# ============================================================
# Levanter-MD — arquivo de configuração de exemplo
# Copie este arquivo para ".env" e ajuste os valores.
# (Alternativa: use config.json.example se preferir editar em JSON.)
# ============================================================

# IDs das sessões que o bot deve iniciar, separados por vírgula.
# Cada ID gera uma pasta própria em ./sessions/<ID> com suas
# próprias credenciais, isolada das demais sessões.
SESSION_IDS=principal

# Números com permissão de dono, separados por vírgula (só dígitos, com
# DDI — ex.: 5511999999999,5565988887777). Comandos marcados como
# "owner: true" só respondem a estes números. Se ficar vazio, nenhum
# comando restrito funciona (em vez de liberar para todo mundo).
OWNER_NUMBERS=

# Idioma padrão usado quando uma sessão/chat não define o próprio.
# Idiomas disponíveis: pt, en, es, hi, ar, fr, bn, id, ml, ru, tr, ur, zh
DEFAULT_LANGUAGE=pt

# Prefixo usado para reconhecer comandos (ex.: .menu, !menu, /menu)
BOT_PREFIX=.

# Método de login: "qr" imprime um QR Code no terminal,
# "pairing" gera um código de pareamento por número de telefone.
LOGIN_METHOD=qr

# Número de telefone para pareamento por código (formato internacional,
# apenas dígitos, ex.: 5511999999999). Só é usado se LOGIN_METHOD=pairing
# e só vale quando existe UMA sessão.
PAIRING_NUMBER=

# Com mais de uma sessão, informe um número por sessão, no formato
# "sessao:numero", separados por vírgula. Exemplo, para
# SESSION_IDS=principal,amigo:
#   PAIRING_NUMBERS=principal:5511999999999,amigo:5521988887777
# Cada sessão recebe o seu próprio código de pareamento ao iniciar.
PAIRING_NUMBERS=

# ---- Recursos automáticos (true/false) ----
AUTO_READ_MESSAGES=true
AUTO_VIEW_STATUS=true
AUTO_REACT_STATUS=false
AUTO_REJECT_CALLS=true
AUTO_REPLY_ENABLED=true

# Mensagem enviada a quem liga quando AUTO_REJECT_CALLS=true
# (deixe em branco para não enviar nenhuma mensagem)
CALL_REJECT_MESSAGE_KEY=call_rejected

# ---- Figurinhas (stickers) ----
STICKER_PACK_NAME=Levanter-MD
STICKER_PACK_AUTHOR=Meu Bot

# ---- API HTTP (opcional, esqueleto ainda sem rotas) ----
API_ENABLED=false
API_PORT=3000

# ---- Logs ----
# Nível do bot: trace, debug, info, warn, error
LOG_LEVEL=info

# true = saída colorida e compacta (melhor no Termux)
# false = JSON cru, para painéis que processam os logs
LOG_PRETTY=true

# Nível dos logs internos do Baileys. Ele registra cada nó do protocolo e,
# no mesmo nível do bot, afoga as mensagens úteis. Suba para "warn" ou
# "debug" só quando precisar investigar a conexão.
BAILEYS_LOG_LEVEL=silent

# Salvar os logs também em arquivo (um por dia, em JSON, dentro de LOG_DIR)
LOG_TO_FILE=false
LOG_DIR=logs
LOG_RETENTION_DAYS=7

# Registrar o TEXTO das mensagens no log. Conteúdo de mensagem é dado
# pessoal — por padrão só o tamanho é registrado.
LOG_MESSAGE_CONTENT=false
